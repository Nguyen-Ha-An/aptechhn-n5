    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "26.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8",
